pipeline {

agent any 

stages {
stage ('git checkout') {
steps {
git branch: 'main' , url: 'https://github.com/Gousia20/my-project-amazon.git'
}
}

stage ('build') {
steps {

sh 'mvn clean package'
}
}
stage('Deploy') {
    steps {
        sh '''
        if docker exec tomcat ls /usr/local/tomcat/webapps/mywar.war > /dev/null 2>&1
        then
            echo "WAR file already exists!"
            exit 1
        fi

        docker cp target/mywar.war tomcat:/usr/local/tomcat/webapps/
        '''
    }
}
}
}










































































